@model IEnumerable<Amaretto.Application.DTOs.UsuarioDTO>
@{
    ViewData["Title"] = "Listado de Productos";
}

<section class="user-list-section">
    <div class="container">
        <h2 class="user-list-title">Lista de Usuarios – Nancy Yuliana Araya Norori</h2>

        <a asp-action="Create" class="btn-create-combo">
            <i class="bi bi-plus-circle"></i> Crear nuevo
        </a>

        <div class="user-list-card">
            <table class="user-table">
                <thead>
                    <tr>
                        <th>Id Usuario</th>
                        <th>Nombre</th>
                        <th>Rol</th>
                        <th>Email</th>
                        <th>Teléfono</th>
                        <th>Detalle</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model)
                    {
                        var roleClass = u.NombreRol.ToLower() switch
                        {
                            "administrador" => "role-admin",
                            "encargado" => "role-encargado",
                            "cocinero" => "role-cocinero",
                            _ => ""
                        };

                        <tr>
                            <td data-label="Id"><span class="user-table-id">@u.IdUsuario</span></td>
                            <td data-label="Nombre">
                                <div class="user-table-name">
                                    <span class="user-table-avatar"><i class="bi bi-person-fill"></i></span>
                                    @u.NombreCompleto
                                </div>
                            </td>
                            <td data-label="Rol"><span class="user-role-badge @roleClass">@u.NombreRol</span></td>
                            <td data-label="Email"><span class="user-table-email">@u.Email</span></td>
                            <td data-label="Teléfono">@(u.Telefono ?? "—")</td>
                            <td data-label="Detalle">
                                <a asp-action="Details"
                                   asp-route-id="@u.IdUsuario"
                                   class="btn-table-action btn-view"
                                   title="Ver detalle">
                                    <i class="bi bi-eye"></i>
                                </a>

                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>