@model IEnumerable<Amaretto.Application.DTOs.ProductoDTO>

@{
    ViewData["Title"] = "Listado Productos";
}

<h1>Listado de Productos</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Crear nuevo</a>
</p>

<table class="table table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>Categoría</th>
            <th>Nombre</th>
            <th>Descripción</th>
            <th>Precio</th>
            <th>Personalizable</th>
            <th>Estado</th>
            <th>Imagen</th>
            <th>Acciones</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>

                <td>@item.IdCategoriaNavigation.Nombre</td>

                <td><strong>@item.Nombre</strong></td>

                <td style="max-width: 200px;">
                    @item.Descripcion
                </td>

                <td>₡@item.Precio</td>

                <td>
                    @(item.EsPersonalizable ? "Sí" : "No")
                </td>

                <td>
                    @(item.Estado ? "Activo" : "Inactivo")
                </td>

                <td style="width:120px;">
                    <img src="@item.Imagen1"
                         style="width:80px; height:80px; object-fit:cover; border-radius:8px;"
                         alt="img" />
                </td>

                <td>
                    <a asp-action="Details"
                       asp-route-id="@item.IdProducto"
                       class="btn btn-info btn-sm">
                        Detalle
                    </a>
                </td>

            </tr>
        }
    </tbody>
</table>