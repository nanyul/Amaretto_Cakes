@model IEnumerable<Amaretto.Application.DTOs.ProductoDTO>
@{
    ViewData["Title"] = "Listado de Productos";
}


<section class="product-list-section">
    <div class="container">
        <h2 class="product-list-title">Lista de Productos</h2>

        <a asp-action="Create" class="btn-create-combo">
            <i class="bi bi-plus-circle"></i> Crear nuevo
        </a>


        <div class="product-list-card">
            <table class="product-table">
                <thead>
                    <tr>
                        <th>Producto</th>
                        <th>Categoría</th>
                        <th>Precio</th>
                        <th>Estado</th>
                        <th>Personalizable</th>
                        <th>Detalle</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td data-label="Producto">
                                <div class="product-table-name">
                                    <span class="product-table-thumb">
                                        @if (!string.IsNullOrEmpty(p.Imagen1))
                                        {
                                            <img src="@p.Imagen1" alt="@p.Nombre" />
                                        }
                                        else
                                        {
                                            <i class="bi bi-image"></i>
                                        }
                                    </span>
                                    @p.Nombre
                                </div>
                            </td>
                            <td data-label="Categoría">
                                <span class="product-category-badge">@p.IdCategoriaNavigation.Nombre</span>
                            </td>
                            <td data-label="Precio">
                                <span class="product-table-price">&#x20A1;@p.Precio.ToString("N2")</span>
                            </td>
                            <td data-label="Estado">
                                @if (p.Estado)
                                {
                                    <span class="product-status-badge is-available"><i class="bi bi-check-circle-fill"></i> Disponible</span>
                                }
                                else
                                {
                                    <span class="product-status-badge is-unavailable"><i class="bi bi-x-circle-fill"></i> No disponible</span>
                                }
                            </td>
                            <td data-label="Personalizable">
                                @if (p.EsPersonalizable)
                                {
                                    <span class="product-custom-badge"><i class="bi bi-stars"></i> Sí</span>
                                }
                                else
                                {
                                    <span class="product-custom-badge is-no">No</span>
                                }
                            </td>
                            <td data-label="Detalle">
                                <a asp-action="Details" asp-route-id="@p.IdProducto" class="btn-ver-detalle">
                                    Ver detalle <i class="bi bi-arrow-right"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>