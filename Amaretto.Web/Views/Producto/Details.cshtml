@model Amaretto.Application.DTOs.ProductoDTO

@{
    ViewData["Title"] = "Detalle Producto";
}

<h2>Detalle del Producto</h2>

<div class="card">
    <div class="card-body">

        <div class="row">

            <div class="col-md-4">
                <img src="@Model.Imagen1"
                     class="img-fluid rounded"
                     alt="@Model.Nombre" />
            </div>

            <div class="col-md-8">

                <h3>@Model.Nombre</h3>

                <p>
                    <strong>Descripción:</strong><br />
                    @Model.Descripcion
                </p>

                <p>
                    <strong>Categoría:</strong>
                    @Model.IdCategoriaNavigation.Nombre
                </p>

                <p>
                    <strong>Precio:</strong>
                    ₡@Model.Precio
                </p>

                <p>
                    <strong>Ingredientes:</strong>
                </p>

                <ul>
                    @foreach (var item in Model.ProductoIngrediente)
                    {
                        <li>@item.IdIngredienteNavigation.Nombre</li>
                    }
                </ul>

            </div>

        </div>

    </div>
</div>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-secondary">
        Regresar
    </a>
</div>