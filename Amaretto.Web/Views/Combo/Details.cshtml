@model Amaretto.Application.DTOs.ComboDTO

@{
    ViewData["Title"] = "Detalle Combo";
}

<h2 class="mb-3">Detalle del Combo</h2>

<div class="card shadow-sm">
    <div class="card-body">

        <div class="row">

            <!-- Imagen -->
            <div class="col-md-4">
                <img src="@Model.Imagen1"
                     class="img-fluid rounded"
                     style="max-height: 300px; object-fit: cover;"
                     alt="Imagen del combo" />
            </div>

            <!-- Información -->
            <div class="col-md-8">

                <h3>@Model.Nombre</h3>

                <p>
                    <strong>Descripción:</strong><br />
                    @Model.Descripcion
                </p>

                <p>
                    <strong>Precio:</strong>
                    ₡@Model.Precio
                </p>

                <p>
                    <strong>Estado:</strong>
                    @if (Model.Estado)
                    {
                        <span class="badge bg-success">Activo</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Inactivo</span>
                    }
                </p>

                <p>
                    <strong>Productos del combo:</strong>
                </p>

                <ul class="list-group">
                    @foreach (var producto in Model.Producto)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            @producto.Nombre
                        </li>
                    }
                </ul>

            </div>
        </div>

    </div>
</div>

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.IdCombo" class="btn btn-primary">Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Regresar</a>
</div>

