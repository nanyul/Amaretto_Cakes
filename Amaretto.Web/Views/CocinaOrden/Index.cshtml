@model List<Amaretto.Application.DTOs.CocinaOrdenDTO>
@{
    ViewData["Title"] = "Listado de Órdenes";

    string ObtenerNombre(Amaretto.Application.DTOs.CocinaOrdenDTO m)
    {
        if (m.IdDetalleNavigation?.IdProductoNavigation != null)
        {
            return m.IdDetalleNavigation.IdProductoNavigation.Nombre;
        }
        else if (m.IdDetalleNavigation?.IdComboNavigation != null)
        {
            return m.IdDetalleNavigation.IdComboNavigation.Nombre;
        }
        return string.Empty;
    }

    string? ObtenerImagen(Amaretto.Application.DTOs.CocinaOrdenDTO m)
    {
        if (m.IdDetalleNavigation?.IdProductoNavigation != null)
        {
            return m.IdDetalleNavigation.IdProductoNavigation.Imagen1;
        }
        else if (m.IdDetalleNavigation?.IdComboNavigation != null)
        {
            return m.IdDetalleNavigation.IdComboNavigation.Imagen1;
        }
        return null;
    }

    // Agrupado por IdDetalle (el proceso real), no por nombre — así dos pedidos
    // distintos del mismo producto no se mezclan en un solo bloque/edición.
    var grupos = Model.GroupBy(m => m.IdDetalle).ToList();
}
<section class="cocina-order-section">
    <div class="container">

        <!-- Encabezado -->
        <div class="cocina-order-header-row">
            <div class="cocina-order-heading">
                <h1 class="cocina-order-title">
                    <span class="cocina-order-flourish"><i class="bi bi-stars"></i></span>
                    Listado de Órdenes
                    <span class="cocina-order-flourish"><i class="bi bi-stars"></i></span>
                </h1>
                <p class="cocina-order-subtitle">
                    <i class="bi bi-heart-fill"></i> Sigue cada preparación con detalle y amor <i class="bi bi-heart-fill"></i>
                </p>
                <span class="cocina-order-count">@grupos.Count() proceso@(grupos.Count() == 1 ? "" : "s")</span>
            </div>
            <a asp-action="Create" class="btn-create-combo">
                <i class="bi bi-plus-circle"></i> Crear proceso
            </a>
        </div>

        <!-- Tabla -->
        <div class="cocina-order-card">
            <table class="cocina-order-table">
                <thead>
                    <tr>
                        <th><i class="bi bi-cup-hot"></i> Nombre</th>
                        <th><i class="bi bi-list-check"></i> Cantidad de Pasos</th>
                        <th><i class="bi bi-heart-fill"></i> Detalles</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var esPrimerGrupo = true;
                    }
                    @foreach (var grupo in grupos)
                    {
                        if (!esPrimerGrupo)
                        {
                            <tr class="cocina-order-divider-row">
                                <td colspan="3">
                                    <div class="cocina-order-divider">
                                        <span></span>
                                        <i class="bi bi-heart-fill"></i>
                                        <span></span>
                                    </div>
                                </td>
                            </tr>
                        }
                        esPrimerGrupo = false;

                        var nombreGrupo = ObtenerNombre(grupo.First());
                        var imagenGrupo = ObtenerImagen(grupo.First());
                        var idDetalleGrupo = grupo.Key;
                        var esPrimeraFila = true;

                        foreach (var menu in grupo)
                        {
                            <tr>
                                <td data-label="Nombre">
                                    <div class="cocina-order-name@(esPrimeraFila ? "" : " is-continuation")">
                                        @if (esPrimeraFila)
                                        {
                                            <span class="cocina-order-thumb">
                                                @if (!string.IsNullOrEmpty(imagenGrupo))
                                                {
                                                    <img src="@imagenGrupo" alt="@nombreGrupo" />
                                                }
                                                else
                                                {
                                                    <i class="bi bi-cake2"></i>
                                                }
                                            </span>
                                        }
                                        <span>@nombreGrupo</span>
                                    </div>
                                </td>
                                <td data-label="Cantidad de Pasos">@menu.OrdenPaso</td>
                                <td data-label="Detalles">
                                    <div class="cocina-order-actions">
                                        <a class="btn-ver-orden"
                                           asp-controller="CocinaOrden" asp-action="Details" asp-route-id="@menu.IdCocinaOrden">
                                            <i class="bi bi-eye-fill"></i> Ver orden
                                        </a>
                                        <a class="btn-editar-orden"
                                           asp-controller="CocinaOrden" asp-action="Edit" asp-route-id="@idDetalleGrupo">
                                            <i class="bi bi-pencil-fill"></i> Editar
                                        </a>
                                    </div>
                                </td>
                            </tr>
                            esPrimeraFila = false;
                        }
                    }
                </tbody>
            </table>

            @if (!Model.Any())
            {
                <div class="cocina-order-empty">
                    <i class="bi bi-cup-hot"></i>
                    <p>Todavía no hay órdenes de cocina registradas.</p>
                </div>
            }
        </div>

    </div>
</section>
