@{
    Layout = null;
    ViewData["Title"] = "Acceso Denegado - Amaretto Cakes";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/amaretto.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/sweetalert2.min.css" asp-append-version="true" />
</head>
<body class="login-page">
    <!-- Partículas flotantes -->
    <div class="login-confeti" aria-hidden="true">
        @{
            var pieces = new[] { "✦", "🌸", "✦", "🎂", "✦", "🍰", "✦", "🌸", "✦", "🎂", "✦", "🍰" };
            var colors = new[] { "var(--moss-green)", "var(--rosy-brown)", "var(--beige)" };
            var rnd = new Random();
            for (int i = 0; i < pieces.Length; i++)
            {
                var left = rnd.Next(5, 95);
                var top = rnd.Next(5, 95);
                var size = (rnd.Next(8, 18) / 10.0).ToString("0.0", System.Globalization.CultureInfo.InvariantCulture);
                var duration = rnd.Next(6, 10).ToString(System.Globalization.CultureInfo.InvariantCulture);
                var delay = (i * 0.4).ToString("0.0", System.Globalization.CultureInfo.InvariantCulture);
                var color = colors[rnd.Next(colors.Length)];
                var style = $"--fp-left:{left}%; --fp-top:{top}%; --fp-size:{size}rem; --fp-duration:{duration}s; --fp-delay:{delay}s; --fp-color:{color};";
                <span class="float-piece" style="@style">@pieces[i]</span>
            }
        }
    </div>

    <main class="min-vh-100 d-flex align-items-center justify-content-center p-3">
        <div class="w-100" style="max-width: 420px;">
            <!-- Logo -->
            <div class="text-center mb-4">
                <img src="~/images/logo-amaretto.png" alt="Amaretto Cakes" class="login-logo" style="height: 80px;">
            </div>

            <!-- Tarjeta Forbidden -->
            <div class="card login-card shadow-lg border-0">
                <div class="card-body p-4 p-md-5 text-center">
                    <div class="forbidden-icon mb-4">
                        <i class="bi bi-shield-lock" style="font-size: 5rem; color: var(--rosy-brown);"></i>
                    </div>
                    <h2 class="login-title mb-3">Acceso Denegado</h2>
                    <p class="login-subtitle mb-4">
                        Lo sentimos, no tienes permisos para acceder a esta página.<br>
                        Por favor, inicia sesión con una cuenta autorizada o contacta al administrador.
                    </p>
                    <div class="d-grid gap-2 d-md-flex justify-content-md-center">
                        <a href="javascript:history.back()" class="btn btn-pill btn-amaretto-outline me-md-2">
                            <i class="bi bi-arrow-left me-2"></i>Volver
                        </a>
                        <a asp-controller="Login" asp-action="Index" class="btn btn-pill btn-amaretto-main">
                            <i class="bi bi-box-arrow-in-right me-2"></i>Iniciar Sesión
                        </a>
                    </div>
                </div>
            </div>

            <footer class="text-center mt-4 text-muted small">
                <p class="mb-0">© 2026 Amaretto Cakes. Todos los derechos reservados.</p>
            </footer>
        </div>
    </main>

    <!-- Ola inferior -->
    <div class="wave-bottom login-wave" aria-hidden="true">
        <svg viewBox="0 0 1440 80" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M0,40 C480,80 960,0 1440,50 L1440,80 L0,80 Z" fill="var(--dark-green)" />
        </svg>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>