@model Amaretto.Application.DTOs.LoginDTO
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Iniciar Sesión - Amaretto Cakes</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/amaretto.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/sweetalert2.min.css" asp-append-version="true" />
</head>
<body class="login-page">
    <!-- Partículas flotantes -->
    <div class="login-confeti" aria-hidden="true">
        @{
            var pieces = new[] { "✦", "🌸", "✦", "🎂", "✦", "🍰", "✦", "🌸", "✦", "🎂", "✦", "🍰" };
            var colors = new[] { "var(--moss-green)", "var(--rosy-brown)", "var(--beige)" };
            var rnd = new Random();
            for (int i = 0; i < pieces.Length; i++)
            {
                var left = rnd.Next(5, 95);
                var top = rnd.Next(5, 95);
                var size = (rnd.Next(8, 18) / 10.0).ToString("0.0", System.Globalization.CultureInfo.InvariantCulture);
                var duration = rnd.Next(6, 10).ToString(System.Globalization.CultureInfo.InvariantCulture);
                var delay = (i * 0.4).ToString("0.0", System.Globalization.CultureInfo.InvariantCulture);
                var color = colors[rnd.Next(colors.Length)];
                var style = $"--fp-left:{left}%; --fp-top:{top}%; --fp-size:{size}rem; --fp-duration:{duration}s; --fp-delay:{delay}s; --fp-color:{color};";
                <span class="float-piece" style="@style">@pieces[i]</span>
            }
        }
    </div>

    <main class="min-vh-100 d-flex align-items-center justify-content-center p-3">
        <div class="w-100" style="max-width: 420px;">
            <!-- Logo -->
            <div class="text-center mb-4">
                <img src="~/images/logo-amaretto.png" alt="Amaretto Cakes" class="login-logo" style="height: 80px;">
            </div>

            <!-- Tarjeta Login -->
            <div class="card login-card shadow-lg border-0">
                <div class="card-body p-4 p-md-5">
                    <header class="text-center mb-4">
                        <h1 class="login-title">Iniciar Sesión</h1>
                        <p class="login-subtitle">Bienvenido de nuevo a Amaretto Cakes</p>
                    </header>

                    <form asp-controller="Login" asp-action="LogIn" method="post" asp-antiforgery="true" class="login-form">
                        <div asp-validation-summary="All" class="text-danger mb-3"></div>

                        <!-- Email -->
                        <div class="input-group mb-3">
                            <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                            <input asp-for="Email" type="email" class="form-control login-input" 
                                   placeholder="Correo Electrónico" autocomplete="email" required />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small d-block mb-3"></span>

                        <!-- Password -->
                        <!-- Password -->
                        <div class="input-group mb-3">
                            <span class="input-group-text"><i class="bi bi-lock"></i></span>
                            <input asp-for="Password" type="password" id="passwordInput" class="form-control login-input"
                                   placeholder="Contraseña" autocomplete="current-password" required />
                            <span class="input-group-text toggle-password" style="cursor: pointer;" onclick="togglePassword()">
                                <i class="bi bi-eye-slash" id="toggleIcon"></i>
                            </span>
                        </div>
                        <span asp-validation-for="Password" class="text-danger small d-block mb-4"></span>

                        <!-- Submit -->
                        <button type="submit" class="btn btn-pill btn-amaretto-main w-100 py-3 mb-3">
                            <i class="bi bi-box-arrow-in-right me-2"></i>Iniciar Sesión
                        </button>
                    </form>

                    <div class="text-center login-footer">
                        <p class="mb-2">¿No tienes cuenta?</p>
                        <a asp-controller="Login" asp-action="Register" class="btn btn-pill btn-amaretto-outline">
                            <i class="bi bi-person-plus me-2"></i>Crear Cuenta
                        </a>
                    </div>
                </div>
            </div>

    
        </div>
    </main>

    <!-- Ola inferior -->
    <div class="wave-bottom login-wave" aria-hidden="true">
        <svg viewBox="0 0 1440 80" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M0,40 C480,80 960,0 1440,50 L1440,80 L0,80 Z" fill="var(--dark-green)" />
        </svg>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @if (TempData["Mensaje"] != null)
    {
        <script>
            (function () {
                var originalFire = window.Swal.fire.bind(window.Swal);
                var Swal = {
                    fire: function (options) {
                        var titulosToast = ['Bienvenido', 'Hasta pronto'];
                        if (titulosToast.indexOf(options.title) !== -1) {
                            options = Object.assign({
                                toast: true,
                                position: 'bottom-end',
                                showConfirmButton: false,
                                timer: 1800,
                                timerProgressBar: true
                            }, options);
                        }
                        return originalFire(options);
                    }
                };
                @Html.Raw(TempData["Mensaje"])
            })();
        </script>
    }
    <script>
        function togglePassword() {
            const input = document.getElementById('passwordInput');
            const icon = document.getElementById('toggleIcon');
            const isPassword = input.type === 'password';
            input.type = isPassword ? 'text' : 'password';
            icon.classList.toggle('bi-eye-slash', !isPassword);
            icon.classList.toggle('bi-eye', isPassword);
        }
    </script>
</body>
</html>