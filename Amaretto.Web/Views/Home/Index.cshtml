@using System.Globalization
@{
    ViewData["Title"] = "Inicio - Amaretto Cakes";

    
    var pieces = new[] { "✦", "🌸", "✦", "🎂", "✦", "🍰", "✦", "🌸", "✦", "🎂", "✦", "🍰" };

    // Colores disponibles para las partículas tipo "✦"
    var colors = new[] { "var(--moss-green)", "var(--rosy-brown)", "var(--beige)" };

    var rnd = new Random();

    string FloatPieceStyle(int index)
    {
        var left = rnd.Next(2, 96);
        var top = rnd.Next(5, 85);
        var size = (rnd.Next(7, 16) / 10.0).ToString("0.0", CultureInfo.InvariantCulture);
        var duration = rnd.Next(5, 9).ToString(CultureInfo.InvariantCulture);
        var delay = ((index % pieces.Length) * 0.3).ToString("0.0", CultureInfo.InvariantCulture);
        var color = colors[rnd.Next(colors.Length)];

        return $"--fp-left:{left}%; --fp-top:{top}%; --fp-size:{size}rem; --fp-duration:{duration}s; --fp-delay:{delay}s; --fp-color:{color};";
    }
}

<!--  HERO  -->
<section class="hero-amaretto has-wave">

    <div class="hero-confeti" aria-hidden="true">
        @for (int i = 0; i < pieces.Length; i++)
        {
            <span class="float-piece" style="@FloatPieceStyle(i)">@pieces[i]</span>
        }
    </div>

    <div class="container position-relative" style="z-index:2;">
        <div class="row align-items-center">

            <div class="col-lg-6">
                <p class="hero-badge">✦ PASTELERÍA ARTESANAL ✦</p>
                <h1 class="hero-title-main">
                    Hecho con amor,
                    <span>para endulzar<br>tus momentos</span>
                </h1>
                <p class="hero-description-main">
                    Pasteles y postres artesanales elaborados con<br>
                    ingredientes de calidad y un toque único.
                </p>
                <div class="d-flex gap-3 flex-wrap mt-4">
                    <a asp-controller="Producto" asp-action="Catalogo" class="btn btn-pill btn-amaretto-main">
                        Ver productos <i class="bi bi-heart-fill ms-1"></i>
                    </a>
                    <a asp-controller="Combo" asp-action="Catalogo" class="btn btn-pill btn-amaretto-outline">
                        Personaliza tu pastel <i class="bi bi-star ms-1"></i>
                    </a>
                </div>
            </div>

            <div class="col-lg-6 text-center mt-4 mt-lg-0">
                <img src="~/images/hero-cake.png"
                     class="hero-cake-image img-fluid rounded-4"
                     alt="Pastel principal">
            </div>

        </div>
    </div>

    <!-- Ola inferior -->
    <div class="wave-bottom" aria-hidden="true">
        <svg viewBox="0 0 1440 80" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M0,0 C240,80 480,80 720,40 C960,0 1200,0 1440,60 L1440,80 L0,80 Z" fill="#839958" />
        </svg>
    </div>

</section>

