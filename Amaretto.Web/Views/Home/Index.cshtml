<!--  CTA con confeti animado  -->
<section class="cta-confeti">

    <div class="confeti-container" aria-hidden="true">
        @for (int i = 0; i < pieces.Length; i++)
        {
            <span class="float-piece" style="@FloatPieceStyle(i + 100)">@pieces[i]</span>
        }
    </div>

    <div class="cta-circle cta-circle-1"></div>
    <div class="cta-circle cta-circle-2"></div>
    <div class="cta-circle cta-circle-3"></div>

    <div class="container position-relative">
        <div class="cta-inner text-center">

            <span class="cta-label">✦ ¿Lista para celebrar? ✦</span>

            <h2 class="cta-heading">
                Endulza tu día con<br>
                <span>Amaretto Cakes</span>
            </h2>

            <p class="cta-sub">
                Pasteles artesanales hechos con amor, listos para hacer<br>
                de cada momento algo inolvidable.
            </p>

            <div class="cta-buttons">
                <a asp-controller="Producto" asp-action="Catalogo" class="btn btn-pill btn-cta-primary">
                    <i class="bi bi-bag-heart-fill me-2"></i> Ver Productos
                </a>
                <a asp-controller="Combo" asp-action="Catalogo" class="btn btn-pill btn-cta-secondary">
                    <i class="bi bi-star-fill me-2"></i> Ver Combos
                </a>
            </div>

        </div>
    </div>

</section>
