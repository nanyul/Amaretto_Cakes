@{
    ViewData["Title"] = "Inicio - Amaretto Cakes";
}

<!--  HERO  -->
<section class="hero-amaretto">

    <div class="hero-confeti" aria-hidden="true">
        <span class="hero-piece hp1">✦</span>
        <span class="hero-piece hp2">🌸</span>
        <span class="hero-piece hp3">✦</span>
        <span class="hero-piece hp4">🎂</span>
        <span class="hero-piece hp5">✦</span>
        <span class="hero-piece hp6">🍰</span>
        <span class="hero-piece hp7">✦</span>
        <span class="hero-piece hp8">🌸</span>
        <span class="hero-piece hp9">✦</span>
        <span class="hero-piece hp10">🎂</span>
        <span class="hero-piece hp11">✦</span>
        <span class="hero-piece hp12">🍰</span>
    </div>

    <div class="container position-relative" style="z-index:2;">
        <div class="row align-items-center">

            <div class="col-lg-6">
                <p class="hero-badge">✦ PASTELERÍA ARTESANAL ✦</p>
                <h1 class="hero-title-main">
                    Hecho con amor,
                    <span>para endulzar<br>tus momentos</span>
                </h1>
                <p class="hero-description-main">
                    Pasteles y postres artesanales elaborados con<br>
                    ingredientes de calidad y un toque único.
                </p>
                <div class="d-flex gap-3 flex-wrap mt-4">
                    <a asp-controller="Producto" asp-action="Catalogo" class="btn btn-amaretto-main">
                        Ver productos <i class="bi bi-heart-fill ms-1"></i>
                    </a>
                    <a asp-controller="Combo" asp-action="Catalogo" class="btn btn-amaretto-outline">
                        Personaliza tu pastel <i class="bi bi-star ms-1"></i>
                    </a>
                </div>
            </div>

            <div class="col-lg-6 text-center mt-4 mt-lg-0">
                <img src="~/images/hero-cake.png"
                     class="hero-cake-image img-fluid"
                     class="img-fluid rounded-4"
                     alt="Pastel principal">
            </div>

        </div>
    </div>

    <!-- Ola inferior -->
    <div class="wave-bottom" aria-hidden="true">
        <svg viewBox="0 0 1440 80" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M0,0 C240,80 480,80 720,40 C960,0 1200,0 1440,60 L1440,80 L0,80 Z" fill="#839958" />
        </svg>
    </div>

</section>

<!-- ===== NUESTROS FAVORITOS ===== -->
<section class="favorites-section">

    <!-- Ola superior: repite el beige entrando desde arriba (ya la hace la ola del hero) -->

    <div class="container">
        <h2 class="section-title">
            <span class="section-badge">✦ Nuestros favoritos ✦</span>
        </h2>

        <div class="row g-4 justify-content-center">

            <div class="col-lg-3 col-md-6">
                <div class="favorite-card">
                    <div class="favorite-card-img">
                        <img src="~/images/producto1.jpg" alt="Fresa y Vainilla">
                    </div>
                    <div class="favorite-card-body">
                        <h5>Fresa & Vainilla</h5>
                        <p class="favorite-price">$32.000</p>
                        <a asp-controller="Producto" asp-action="Catalogo" class="btn btn-favorite">
                            Ver más <i class="bi bi-heart-fill ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="favorite-card">
                    <div class="favorite-card-img">
                        <img src="~/images/producto2.jpg" alt="Macarons">
                    </div>
                    <div class="favorite-card-body">
                        <h5>Macarons</h5>
                        <p class="favorite-price">$18.000</p>
                        <a asp-controller="Producto" asp-action="Catalogo" class="btn btn-favorite">
                            Ver más <i class="bi bi-heart-fill ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="favorite-card">
                    <div class="favorite-card-img">
                        <img src="~/images/producto3.jpg" alt="Cupcake de Chocolate">
                    </div>
                    <div class="favorite-card-body">
                        <h5>Cupcake de Chocolate</h5>
                        <p class="favorite-price">$15.000</p>
                        <a asp-controller="Producto" asp-action="Catalogo" class="btn btn-favorite">
                            Ver más <i class="bi bi-heart-fill ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="favorite-card">
                    <div class="favorite-card-img">
                        <img src="~/images/producto4.jpg" alt="Chocolate Premium">
                    </div>
                    <div class="favorite-card-body">
                        <h5>Chocolate Premium</h5>
                        <p class="favorite-price">$38.000</p>
                        <a asp-controller="Producto" asp-action="Catalogo" class="btn btn-favorite">
                            Ver más <i class="bi bi-heart-fill ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <!-- Ola inferior -->
    <div class="wave-bottom" aria-hidden="true">
        <svg viewBox="0 0 1440 80" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M0,60 C360,0 720,80 1080,20 C1260,0 1380,40 1440,60 L1440,80 L0,80 Z" fill="#FFFDF6" />
        </svg>
    </div>

</section>

<!--  SOBRE NOSOTROS  -->
<section class="about-amaretto">
    <div class="container">
        <div class="row align-items-center gy-5">

            <div class="col-lg-5 text-center">
                <img src="~/images/logo-amaretto.png"
                     class="img-fluid about-illustration"
                     alt="Sobre Amaretto Cakes">
            </div>

            <div class="col-lg-7">
                <p class="about-label">Sobre nosotros</p>
                <h2 class="about-title">
                    Más que postres,
                    <span>creamos recuerdos</span>
                </h2>
                <p class="about-text">
                    En Amaretto Cakes, cada receta cuenta una historia.
                    Usamos ingredientes frescos y de calidad para crear
                    postres que no solo se ven increíbles, sino que saben
                    a momentos especiales.
                </p>
                <a href="#" class="btn btn-amaretto-main mt-2">
                    Conócenos <i class="bi bi-heart-fill ms-1"></i>
                </a>
            </div>

        </div>
    </div>

    <!-- Ola inferior -->
    <div class="wave-bottom" aria-hidden="true">
        <svg viewBox="0 0 1440 80" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M0,40 C480,80 960,0 1440,50 L1440,80 L0,80 Z" fill="#ffffff" />
        </svg>
    </div>

</section>

<!--  BENEFICIOS  -->
<section class="benefits-section">
    <div class="container">
        <div class="row text-center g-4">

            <div class="col-md-3 col-6">
                <div class="benefit-item">
                    <div class="benefit-icon">
                        <i class="bi bi-flower1"></i>
                    </div>
                    <h6>Ingredientes<br><span>de calidad</span></h6>
                </div>
            </div>

            <div class="col-md-3 col-6">
                <div class="benefit-item">
                    <div class="benefit-icon">
                        <i class="bi bi-heart-fill"></i>
                    </div>
                    <h6>Hecho<br><span>con amor</span></h6>
                </div>
            </div>

            <div class="col-md-3 col-6">
                <div class="benefit-item">
                    <div class="benefit-icon">
                        <i class="bi bi-cake2-fill"></i>
                    </div>
                    <h6>Diseños<br><span>personalizados</span></h6>
                </div>
            </div>

            <div class="col-md-3 col-6">
                <div class="benefit-item">
                    <div class="benefit-icon">
                        <i class="bi bi-truck"></i>
                    </div>
                    <h6>Entregas<br><span>a tiempo</span></h6>
                </div>
            </div>

        </div>
    </div>

    <!-- Ola inferior -->
    <div class="wave-bottom" aria-hidden="true">
        <svg viewBox="0 0 1440 80" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M0,20 C300,80 600,0 900,50 C1100,80 1300,10 1440,40 L1440,80 L0,80 Z" fill="#0A3323" />
        </svg>
    </div>

</section>

<!--  CTA con confeti animado  -->
<section class="cta-confeti">

    <div class="confeti-container" aria-hidden="true">
        <span class="confeti-piece c1">✦</span>
        <span class="confeti-piece c2">🎂</span>
        <span class="confeti-piece c3">✦</span>
        <span class="confeti-piece c4">🌸</span>
        <span class="confeti-piece c5">✦</span>
        <span class="confeti-piece c6">🍰</span>
        <span class="confeti-piece c7">✦</span>
        <span class="confeti-piece c8">🌸</span>
        <span class="confeti-piece c9">✦</span>
        <span class="confeti-piece c10">🎂</span>
        <span class="confeti-piece c11">✦</span>
        <span class="confeti-piece c12">🍰</span>
    </div>

    <div class="cta-circle cta-circle-1"></div>
    <div class="cta-circle cta-circle-2"></div>
    <div class="cta-circle cta-circle-3"></div>

    <div class="container position-relative">
        <div class="cta-inner text-center">

            <span class="cta-label">✦ ¿Lista para celebrar? ✦</span>

            <h2 class="cta-heading">
                Endulza tu día con<br>
                <span>Amaretto Cakes</span>
            </h2>

            <p class="cta-sub">
                Pasteles artesanales hechos con amor, listos para hacer<br>
                de cada momento algo inolvidable.
            </p>

            <div class="cta-buttons">
                <a asp-controller="Producto" asp-action="Catalogo" class="btn btn-cta-primary">
                    <i class="bi bi-bag-heart-fill me-2"></i> Ver Productos
                </a>
                <a asp-controller="Combo" asp-action="Catalogo" class="btn btn-cta-secondary">
                    <i class="bi bi-star-fill me-2"></i> Ver Combos
                </a>
            </div>

        </div>
    </div>

</section>

