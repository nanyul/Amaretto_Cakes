@{
    ViewData["Title"] = "Gráfico de Ventas";
}

<div class="container py-4">
    <!-- CARD PRINCIPAL (estilo Amaretto) -->
    <div class="card border-0 shadow-sm" style="border-radius: 18px; border: 1px solid rgba(131,153,88,0.2);">

        <!-- HEADER -->
        <div class="card-header bg-transparent border-0 py-3 px-4" style="border-radius: 18px 18px 0 0; background: linear-gradient(135deg, var(--dark-green) 0%, #0d4a35 100%);">
            <h4 class="mb-0 text-white fw-bold"><i class="bi bi-bar-chart-fill me-2"></i>Panel de Reportes</h4>
            <small class="text-white-50">Administrador / Encargado</small>
        </div>

        <!-- BODY -->
        <div class="card-body p-4">

            <!-- FORM FILTROS FECHA (estilo tu ejemplo) -->
            <form class="row g-3 mb-4" asp-action="Grafico" asp-controller="Reporte" method="get">
                <div class="col-md-3">
                    <label for="fechaDesde" class="form-label fw-semibold text-dark-green"><i class="bi bi-calendar-event me-1"></i>Desde</label>
                    <input type="date" id="fechaDesde" name="fechaDesde" class="form-control form-control-amaretto" value="@ViewBag.FechaDesde" />
                </div>
                <div class="col-md-3">
                    <label for="fechaHasta" class="form-label fw-semibold text-dark-green"><i class="bi bi-calendar-check me-1"></i>Hasta</label>
                    <input type="date" id="fechaHasta" name="fechaHasta" class="form-control form-control-amaretto" value="@ViewBag.FechaHasta" />
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn btn-moss-green w-100 fw-semibold"><i class="bi bi-funnel-fill me-1"></i>Filtrar</button>
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <a asp-action="Grafico" class="btn btn-rosy-brown w-100 fw-semibold"><i class="bi bi-arrow-counterclockwise me-1"></i>Limpiar</a>
                </div>
            </form>

            <!-- KPI CARDS ROW -->
            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <div class="card kpi-card h-100 border-0 shadow-sm" style="border-radius: 14px; background: linear-gradient(135deg, var(--dark-green) 0%, #0d4a35 100%);">
                        <div class="card-body text-center text-white">
                            <i class="bi bi-bag-check-fill fs-2 mb-2 opacity-75"></i>
                            <div class="fs-4 fw-bold" id="kpiPedidos">@ViewBag.TotalPedidos</div>
                            <small>Pedidos en período</small>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card kpi-card h-100 border-0 shadow-sm" style="border-radius: 14px; background: linear-gradient(135deg, var(--moss-green) 0%, #6b8248 100%);">
                        <div class="card-body text-center text-white">
                            <i class="bi bi-box-seam-fill fs-2 mb-2 opacity-75"></i>
                            <div class="fs-4 fw-bold" id="kpiItems">@ViewBag.TotalItems</div>
                            <small>Items vendidos (Top 3)</small>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card kpi-card h-100 border-0 shadow-sm" style="border-radius: 14px; background: linear-gradient(135deg, var(--rosy-brown) 0%, #c07d72 100%);">
                        <div class="card-body text-center text-white">
                            <i class="bi bi-flag-fill fs-2 mb-2 opacity-75"></i>
                            <div class="fs-4 fw-bold" id="kpiEstados">@ViewBag.TotalEstados</div>
                            <small>Estados distintos</small>
                        </div>
                    </div>
                </div>
            </div>

            <!-- CHARTS ROW -->
            <div class="row g-4">
                <!-- Chart 1: Top 3 - Horizontal Bar -->
                <div class="col-lg-6">
                    <div class="card h-100 border-0 shadow-sm" style="border-radius: 14px; border: 1px solid rgba(131,153,88,0.15);">
                        <div class="card-header bg-white border-0 py-3 px-3" style="border-radius: 14px 14px 0 0;">
                            <h6 class="mb-0 fw-bold text-dark-green"><i class="bi bi-trophy-fill me-1 text-moss-green"></i>@ViewBag.TopTitle</h6>
                        </div>
                        <div class="card-body p-3">
                            <div class="chart-wrapper" style="position: relative; height: 300px;">
                                <canvas id="chartTopItems"></canvas>
                            </div>
                            <div id="emptyTopItems" class="text-center py-5 d-none text-midnight-green">
                                <i class="bi bi-box-seam fs-1 mb-2"></i>
                                <p>No hay datos en el período seleccionado</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Chart 2: Estados - Doughnut -->
                <div class="col-lg-6">
                    <div class="card h-100 border-0 shadow-sm" style="border-radius: 14px; border: 1px solid rgba(131,153,88,0.15);">
                        <div class="card-header bg-white border-0 py-3 px-3" style="border-radius: 14px 14px 0 0;">
                            <h6 class="mb-0 fw-bold text-dark-green"><i class="bi bi-pie-chart-fill me-1 text-rosy-brown"></i>@ViewBag.EstadoTitle</h6>
                        </div>
                        <div class="card-body p-3">
                            <div class="chart-wrapper" style="position: relative; height: 300px;">
                                <canvas id="chartEstados"></canvas>
                            </div>
                            <div id="emptyEstados" class="text-center py-5 d-none text-midnight-green">
                                <i class="bi bi-flag fs-1 mb-2"></i>
                                <p>No hay pedidos en el período seleccionado</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <!-- Chart.js CDN -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        $(document).ready(function () {
            initCharts();
        });

        // Paleta Amaretto para Charts
        const AmarettoColors = {
            primary: '#839958',      // moss-green
            primaryLight: 'rgba(131, 153, 88, 0.2)',
            secondary: '#D3968C',    // rosy-brown
            secondaryLight: 'rgba(211, 150, 140, 0.2)',
            dark: '#0A3323',         // dark-green
            darkLight: 'rgba(10, 51, 35, 0.2)',
            accent: '#105666',       // midnight-green
            accentLight: 'rgba(16, 86, 102, 0.2)',
            beige: '#F7F4D5',
            white: '#FFFFFF'
        };

        // Genera colores dinámicos para doughnut
        function getDoughnutColors(count) {
            const base = [AmarettoColors.primary, AmarettoColors.secondary, AmarettoColors.accent, AmarettoColors.dark];
            const light = [AmarettoColors.primaryLight, AmarettoColors.secondaryLight, AmarettoColors.accentLight, AmarettoColors.darkLight];
            const bg = [], border = [];
            for (let i = 0; i < count; i++) {
                bg.push(light[i % light.length]);
                border.push(base[i % base.length]);
            }
            return { backgroundColor: bg, borderColor: border };
        }

        function initCharts() {
            // ---- CHART 1: Top 3 Horizontal Bar ----
            const ctxTop = document.getElementById('chartTopItems');
            const emptyTop = document.getElementById('emptyTopItems');

            const topLabelsStr = '@Html.Raw(ViewBag.TopLabels)';
            const topValuesStr = '@ViewBag.TopValues';

            if (!topLabelsStr || !topValuesStr) {
                if (ctxTop) ctxTop.style.display = 'none';
                if (emptyTop) emptyTop.classList.remove('d-none');
            } else {
                const topLabels = topLabelsStr.split(',').map(s => s.replace(/"/g, ''));
                const topValues = topValuesStr.split(',').map(Number);

                new Chart(ctxTop, {
                    type: 'bar',
                    data: {
                        labels: topLabels,
                        datasets: [{
                            label: '@ViewBag.TopTitle',
                            data: topValues,
                            backgroundColor: AmarettoColors.primaryLight,
                            borderColor: AmarettoColors.primary,
                            borderWidth: 2,
                            borderRadius: 8,
                            borderSkipped: false,
                        }]
                    },
                    options: {
                        indexAxis: 'y',
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                backgroundColor: AmarettoColors.dark,
                                titleColor: AmarettoColors.beige,
                                bodyColor: AmarettoColors.white,
                                padding: 12,
                                cornerRadius: 8,
                                callbacks: {
                                    label: ctx => ` ${ctx.parsed.x} unidades vendidas`
                                }
                            }
                        },
                        scales: {
                            x: {
                                beginAtZero: true,
                                grid: { color: 'rgba(10,51,35,0.08)' },
                                ticks: { color: AmarettoColors.dark, font: { weight: '500' } }
                            },
                            y: {
                                grid: { display: false },
                                ticks: { color: AmarettoColors.dark, font: { weight: '600', size: 12 } }
                            }
                        },
                        animation: { duration: 1000, easing: 'easeOutQuart' }
                    }
                });
            }

            // ---- CHART 2: Estados Doughnut ----
            const ctxEstados = document.getElementById('chartEstados');
            const emptyEstados = document.getElementById('emptyEstados');

            const estadoLabelsStr = '@Html.Raw(ViewBag.EstadoLabels)';
            const estadoValuesStr = '@ViewBag.EstadoValues';

            if (!estadoLabelsStr || !estadoValuesStr) {
                if (ctxEstados) ctxEstados.style.display = 'none';
                if (emptyEstados) emptyEstados.classList.remove('d-none');
            } else {
                const estadoLabels = estadoLabelsStr.split(',').map(s => s.replace(/"/g, ''));
                const estadoValues = estadoValuesStr.split(',').map(Number);
                const colors = getDoughnutColors(estadoLabels.length);

                new Chart(ctxEstados, {
                    type: 'doughnut',
                    data: {
                        labels: estadoLabels,
                        datasets: [{
                            data: estadoValues,
                            backgroundColor: colors.backgroundColor,
                            borderColor: colors.borderColor,
                            borderWidth: 2,
                            borderRadius: 4,
                            spacing: 2,
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        cutout: '60%',
                        plugins: {
                            legend: {
                                position: 'bottom',
                                labels: {
                                    color: AmarettoColors.dark,
                                    font: { size: 12, weight: '500' },
                                    padding: 16,
                                    usePointStyle: true,
                                    pointStyle: 'circle'
                                }
                            },
                            tooltip: {
                                backgroundColor: AmarettoColors.dark,
                                titleColor: AmarettoColors.beige,
                                bodyColor: AmarettoColors.white,
                                padding: 12,
                                cornerRadius: 8,
                                callbacks: {
                                    label: ctx => ` ${ctx.label}: ${ctx.parsed} pedidos (${((ctx.parsed / estadoValues.reduce((a,b)=>a+b,0))*100).toFixed(1)}%)`
                                }
                            }
                        },
                        animation: { animateRotate: true, animateScale: true, duration: 1200, easing: 'easeOutQuart' }
                    }
                });
            }
        }
    </script>

    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}