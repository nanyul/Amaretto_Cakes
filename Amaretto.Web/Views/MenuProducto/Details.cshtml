@model Amaretto.Application.DTOs.MenuProductoDTO
@{
    ViewData["Title"] = Model.Nombre;
}
<section class="menu-detail-section">
    <div class="container">

        <!-- Volver al listado -->
        <a asp-controller="MenuProducto" asp-action="Index" class="btn-back-catalog mb-4">
            <i class="bi bi-arrow-left"></i> Volver a menús
        </a>

        <!-- Encabezado del menú -->
        <div class="menu-detail-header">
            <h1 class="menu-detail-title">
                <span class="menu-detail-flourish">
                    <i class="bi bi-stars"></i>
                </span>
                @Model.Nombre
                <span class="menu-detail-flourish">
                    <i class="bi bi-stars"></i>
                </span>
            </h1>
            <p class="menu-detail-subtitle">@Model.Descripcion</p>
        </div>

        <!-- Disponibilidad -->
        <div class="menu-detail-info-bar">
            <div class="menu-detail-info-item">
                <span class="menu-detail-info-icon">
                    <i class="bi bi-calendar-check"></i>
                </span>
                <div>
                    <span class="menu-detail-info-label">Disponibilidad</span>
                    <span class="menu-detail-info-value">@Model.DiasDisponibles días</span>
                </div>
            </div>
            <span class="menu-detail-info-sep">
                <i class="bi bi-heart-fill"></i>
            </span>
            <div class="menu-detail-info-item">
                <span class="menu-detail-info-icon">
                    <i class="bi bi-calendar-range"></i>
                </span>
                <div>
                    <span class="menu-detail-info-label">Fechas</span>
                    <span class="menu-detail-info-value">
                        @Model.FechaInicio.ToString("dd/MM/yyyy") - @Model.FechaFin.ToString("dd/MM/yyyy")
                    </span>
                </div>
            </div>
        </div>

        <!-- Categorías -->
        <div class="menu-category-grid">
            @foreach (var categoria in Model.MenuDetalleProducto
                        .Where(x => x.IdProductoNavigation != null)
                        .GroupBy(x => x.IdProductoNavigation.IdCategoriaNavigation.Nombre))
            {
                <div class="menu-category-box">
                    <div class="menu-category-header">
                        <span class="menu-category-icon-left"><i class="bi bi-flower1"></i></span>
                        <h2>@categoria.Key</h2>
                        <span class="menu-category-icon-right"><i class="bi bi-flower1"></i></span>
                    </div>

                    <div class="menu-product-list">
                        @foreach (var item in categoria)
                        {
                            <div class="menu-product-row">
                                <div class="menu-product-thumb">
                                    @if (!string.IsNullOrEmpty(item.IdProductoNavigation.Imagen1))
                                    {
                                        <img src="@item.IdProductoNavigation.Imagen1" alt="@item.IdProductoNavigation.Nombre" />
                                    }
                                    else
                                    {
                                        <i class="bi bi-image"></i>
                                    }
                                </div>
                                <div class="menu-product-info">
                                    <strong>@item.IdProductoNavigation.Nombre</strong>
                                    <small>@item.IdProductoNavigation.Descripcion</small>
                                </div>
                                <div class="menu-product-price">
                                    ₡@item.IdProductoNavigation.Precio.ToString("N2")
                                </div>
                            </div>
                            @if (item != categoria.Last())
                            {
                                <div class="menu-product-divider">
                                    <i class="bi bi-heart-fill"></i>
                                </div>
                            }
                        }
                    </div>
                </div>
            }
        </div>

        <!-- Banner de calidad -->
        <div class="menu-quality-banner">
            <span class="menu-quality-icon">
                <i class="bi bi-cupcake"></i>
            </span>
            <div class="menu-quality-text">
                <p>Todos nuestros productos son elaborados con ingredientes de la más alta calidad</p>
                <p class="menu-quality-emphasis">Hecho con amor para endulzar tus momentos <i class="bi bi-heart-fill"></i></p>
            </div>
        </div>

    </div>
</section>
