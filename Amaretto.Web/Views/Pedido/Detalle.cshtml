@model Amaretto.Application.DTOs.PedidoDetalleCompletoDTO
@{
    ViewData["Title"] = $"Detalle del Pedido #{Model.IdPedido}";

    string ClaseEstado(string estado) => estado switch
    {
        "Pagado" => "is-pagado",
        "Entregado" => "is-entregado",
        "En Preparacion" => "is-preparacion",
        "Cancelado" => "is-cancelado",
        _ => "is-pendiente"
    };

    string IconoEstado(string estado) => estado switch
    {
        "Pagado" => "bi-cash-coin",
        "Entregado" => "bi-check-circle-fill",
        "En Preparacion" => "bi-fire",
        "Cancelado" => "bi-x-circle-fill",
        _ => "bi-hourglass-split"
    };
}

<section class="historial-section">
    <div class="container">

        <div class="historial-header">
            <h1 class="historial-title">
                <span class="historial-flourish"><i class="bi bi-stars"></i></span>
                Detalle del Pedido #@Model.IdPedido
                <span class="historial-flourish"><i class="bi bi-stars"></i></span>
            </h1>
            <p class="historial-subtitle">
                <i class="bi bi-calendar-heart"></i>
                @Model.FechaPedido.ToString("dd 'de' MMMM 'de' yyyy, hh:mm tt")
                <i class="bi bi-calendar-heart"></i>
            </p>
            <span class="historial-estado-badge @ClaseEstado(Model.Estado) mt-2">
                <i class="bi @IconoEstado(Model.Estado)"></i> @Model.Estado
            </span>
        </div>

        <!-- Encabezado del pedido -->
        <div class="historial-detalle-grid">

            @if (Model.EsGestor)
            {
                <div class="historial-detalle-box">
                    <h6 class="historial-box-label"><i class="bi bi-person-fill"></i> Cliente</h6>
                    <p class="historial-box-main">@Model.NombreCliente</p>
                    <p class="historial-box-line"><i class="bi bi-envelope"></i> @Model.EmailCliente</p>
                    @if (!string.IsNullOrWhiteSpace(Model.TelefonoCliente))
                    {
                        <p class="historial-box-line"><i class="bi bi-telephone"></i> @Model.TelefonoCliente</p>
                    }
                </div>

                <div class="historial-detalle-box">
                    <h6 class="historial-box-label"><i class="bi bi-person-badge-fill"></i> Encargado</h6>
                    <p class="historial-box-main">
                        @(string.IsNullOrWhiteSpace(Model.NombreEncargado) ? "Pedido en línea" : Model.NombreEncargado)
                    </p>
                    <p class="historial-box-line">
                        @(string.IsNullOrWhiteSpace(Model.NombreEncargado)
                            ? "Registrado por el propio cliente"
                            : "Registrado en tienda")
                    </p>
                </div>
            }

            <div class="historial-detalle-box">
                <h6 class="historial-box-label"><i class="bi bi-truck"></i> Entrega</h6>
                <p class="historial-box-main">@Model.MetodoEntrega</p>
                <p class="historial-box-line">
                    <i class="bi bi-geo-alt"></i>
                    @(string.IsNullOrWhiteSpace(Model.DireccionEntrega) ? "Retiro en tienda" : Model.DireccionEntrega)
                </p>
            </div>

            <div class="historial-detalle-box">
                <h6 class="historial-box-label"><i class="bi bi-credit-card-2-front-fill"></i> Pago</h6>
                @if (Model.Pago != null)
                {
                    <p class="historial-box-main">@Model.Pago.MetodoPago</p>
                    @if (!string.IsNullOrWhiteSpace(Model.Pago.TipoTarjeta))
                    {
                        <p class="historial-box-line">
                            <i class="bi bi-credit-card"></i>
                            @Model.Pago.TipoTarjeta
                            @if (!string.IsNullOrWhiteSpace(Model.Pago.UltimosDigitos))
                            {
                                <span>&nbsp;•••• @Model.Pago.UltimosDigitos</span>
                            }
                        </p>
                    }
                    @if (Model.Pago.MontoRecibido.HasValue)
                    {
                        <p class="historial-box-line">
                            <i class="bi bi-wallet2"></i> Recibido: ₡@Model.Pago.MontoRecibido.Value.ToString("N2")
                        </p>
                        <p class="historial-box-line">
                            <i class="bi bi-arrow-return-left"></i> Vuelto: ₡@((Model.Pago.Vuelto ?? 0m).ToString("N2"))
                        </p>
                    }
                    <p class="historial-box-line">
                        <i class="bi bi-clock"></i> @Model.Pago.FechaPago.ToString("dd/MM/yyyy hh:mm tt") — @Model.Pago.Estado
                    </p>
                }
                else
                {
                    <p class="historial-box-main">Sin pago registrado</p>
                }
            </div>
        </div>

        <!-- Líneas del pedido -->
        <div class="historial-card mt-4">
            <div class="historial-table-wrap">
                <table class="historial-table">
                    <thead>
                        <tr>
                            <th><i class="bi bi-cake2"></i> Producto / Combo</th>
                            <th><i class="bi bi-tag"></i> Precio Unit.</th>
                            <th><i class="bi bi-123"></i> Cantidad</th>
                            <th><i class="bi bi-calculator"></i> Subtotal</th>
                            <th><i class="bi bi-percent"></i> Impuesto</th>
                            <th><i class="bi bi-cash"></i> Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var linea in Model.Lineas)
                        {
                            <tr>
                                <td data-label="Producto / Combo">
                                    <div class="historial-linea-nombre">
                                        <span class="historial-linea-thumb">
                                            @if (!string.IsNullOrEmpty(linea.Imagen))
                                            {
                                                <img src="@linea.Imagen" alt="@linea.Nombre" />
                                            }
                                            else
                                            {
                                                <i class="bi @(linea.Tipo == "combo" ? "bi-box-seam" : "bi-cake2")"></i>
                                            }
                                        </span>
                                        <div>
                                            <strong>@linea.Nombre</strong>
                                            @if (linea.Personalizado)
                                            {
                                                <span class="historial-tag-personalizado">
                                                    <i class="bi bi-stars"></i> Personalizado
                                                </span>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(linea.Observaciones))
                                            {
                                                <span class="historial-linea-obs">
                                                    <i class="bi bi-chat-left-text"></i> @linea.Observaciones
                                                </span>
                                            }
                                        </div>
                                    </div>

                                    @if (linea.Personalizacion != null)
                                    {
                                        var p = linea.Personalizacion;
                                        <ul class="historial-personalizacion">
                                            <li><span>Tamaño</span> @p.Tamano (@p.MedidaCm cm)</li>
                                            <li><span>Bizcocho</span> @p.SaborBizcocho</li>
                                            <li><span>Relleno</span> @p.TipoRelleno</li>
                                            <li>
                                                <span>Decoración</span> @p.TipoDecoracion
                                                @if (!string.IsNullOrWhiteSpace(p.DecoracionDetalle))
                                                {
                                                    <text> — @p.DecoracionDetalle</text>
                                                }
                                            </li>
                                            <li><span>Dedicatoria</span> @p.Dedicatoria</li>
                                            @if (p.PrecioExtra > 0)
                                            {
                                                <li><span>Precio extra</span> ₡@p.PrecioExtra.ToString("N2")</li>
                                            }
                                        </ul>
                                    }
                                </td>
                                <td data-label="Precio Unit.">₡@linea.PrecioUnitario.ToString("N2")</td>
                                <td data-label="Cantidad">@linea.Cantidad</td>
                                <td data-label="Subtotal">₡@linea.Subtotal.ToString("N2")</td>
                                <td data-label="Impuesto">₡@linea.Iva.ToString("N2")</td>
                                <td data-label="Total"><strong class="historial-total">₡@linea.Total.ToString("N2")</strong></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="historial-resumen-wrap">
                @if (!string.IsNullOrWhiteSpace(Model.Observaciones))
                {
                    <div class="historial-observaciones">
                        <h6 class="historial-box-label"><i class="bi bi-chat-left-quote"></i> Observaciones</h6>
                        <p>@Model.Observaciones</p>
                    </div>
                }

                <div class="historial-totales-box">
                    <div><span>Subtotal (sin impuestos)</span><strong>₡@Model.Subtotal.ToString("N2")</strong></div>
                    <div><span>Impuesto (13%)</span><strong>₡@Model.Impuesto.ToString("N2")</strong></div>
                    <div><span>Costo de envío</span><strong>₡@Model.CostoEnvio.ToString("N2")</strong></div>
                    <hr />
                    <div class="historial-total-final"><span>TOTAL DEL PEDIDO</span><strong>₡@Model.Total.ToString("N2")</strong></div>
                </div>
            </div>
        </div>

        <a asp-action="Historial" class="btn-volver-historial mt-4">
            <i class="bi bi-arrow-left"></i> Volver al historial
        </a>

    </div>
</section>
